{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itinerary-engine.local/schemas/web-itinerary-1.0.0.json",
  "title": "Standalone Itinerary Content",
  "description": "Canonical nested brochure content. Publish-only requirements are defined by the field registry and validators.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brochure", "hero", "overview", "schedule", "spots", "practical", "closing"],
  "properties": {
    "schemaVersion": { "const": "web-1.0.0" },
    "brochure": { "$ref": "#/$defs/brochure" },
    "hero": { "$ref": "#/$defs/hero" },
    "overview": { "$ref": "#/$defs/overview" },
    "schedule": { "type": "array", "items": { "$ref": "#/$defs/scheduleBlock" } },
    "spots": { "type": "array", "items": { "$ref": "#/$defs/spot" } },
    "practical": { "$ref": "#/$defs/practical" },
    "closing": { "$ref": "#/$defs/closing" }
  },
  "$defs": {
    "nullableText": { "type": ["string", "null"], "maxLength": 4000 },
    "photoAttribution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["photographer", "photographerUrl", "source"],
      "properties": {
        "photographer": { "type": "string", "maxLength": 240 },
        "photographerUrl": { "type": ["string", "null"], "maxLength": 2048, "format": "uri", "pattern": "^https?://" },
        "source": { "type": "string", "maxLength": 120 }
      }
    },
    "brochure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agencyName", "agencyContact", "tripTitle", "destination", "region", "country", "itineraryMode", "durationDays", "scopeLabel", "startDate", "endDate", "travelerCount", "travelerType", "paceLevel", "themes", "destinationType", "generatedDate", "outputLanguage"],
      "properties": {
        "agencyName": { "type": "string", "maxLength": 160 },
        "agencyContact": { "type": "string", "maxLength": 320 },
        "agencyLogoAssetId": { "$ref": "#/$defs/nullableText", "maxLength": 80 },
        "tripTitle": { "type": "string", "maxLength": 200 },
        "destination": { "type": "string", "maxLength": 200 },
        "region": { "$ref": "#/$defs/nullableText", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 120 },
        "itineraryMode": { "enum": ["half_day", "full_day", "multi_day", "destination_guide"] },
        "durationDays": { "type": ["integer", "null"], "minimum": 2, "maximum": 14 },
        "scopeLabel": { "type": "string", "maxLength": 80 },
        "startDate": { "type": ["string", "null"], "format": "date" },
        "endDate": { "type": ["string", "null"], "format": "date" },
        "travelerCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
        "travelerType": { "$ref": "#/$defs/nullableText", "maxLength": 40 },
        "paceLevel": { "enum": ["Relaxed", "Balanced", "Packed"] },
        "themes": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 120 } },
        "destinationType": { "enum": ["beach", "mountain", "city", "cultural", "nature", "desert", "mixed"] },
        "generatedDate": { "type": ["string", "null"], "format": "date" },
        "outputLanguage": { "type": ["string", "null"], "minLength": 2, "maxLength": 35 }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "photoAttribution", "gradientOnly"],
      "properties": {
        "assetId": { "$ref": "#/$defs/nullableText", "maxLength": 80 },
        "photoAttribution": { "$ref": "#/$defs/photoAttribution" },
        "gradientOnly": { "type": "boolean" }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "quickFacts", "routeSummary", "highlights"],
      "properties": {
        "summary": { "type": "string", "maxLength": 4000 },
        "quickFacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "bestSeason", "pace", "themes"],
          "properties": {
            "scope": { "type": "string", "maxLength": 120 },
            "bestSeason": { "type": "string", "maxLength": 240 },
            "pace": { "type": "string", "maxLength": 80 },
            "themes": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 120 } }
          }
        },
        "routeSummary": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 300 } },
        "highlights": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon", "title", "note"],
            "properties": {
              "icon": { "type": "string", "maxLength": 40 },
              "title": { "type": "string", "maxLength": 120 },
              "note": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeLabel", "type", "title", "description", "durationLabel", "area", "category", "tip"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "timeLabel": { "type": "string", "maxLength": 80 },
        "type": { "enum": ["transport", "sightseeing", "food", "activity", "rest", "accommodation", "free"] },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "durationLabel": { "$ref": "#/$defs/nullableText", "maxLength": 80 },
        "area": { "$ref": "#/$defs/nullableText", "maxLength": 160 },
        "category": { "$ref": "#/$defs/nullableText", "maxLength": 120 },
        "tip": { "$ref": "#/$defs/nullableText", "maxLength": 1000 }
      }
    },
    "scheduleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dayStart", "dayEnd", "date", "title", "location", "isCondensed", "activities", "accommodation", "mealsIncluded", "transportNote", "blockTip"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "dayStart": { "type": "integer", "minimum": 1, "maximum": 14 },
        "dayEnd": { "type": "integer", "minimum": 1, "maximum": 14 },
        "date": { "type": ["string", "null"], "format": "date" },
        "title": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 240 },
        "isCondensed": { "type": "boolean" },
        "assetId": { "$ref": "#/$defs/nullableText", "maxLength": 80 },
        "photoAttribution": { "$ref": "#/$defs/photoAttribution" },
        "activities": { "type": "array", "items": { "$ref": "#/$defs/activity" } },
        "accommodation": { "$ref": "#/$defs/accommodation" },
        "mealsIncluded": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 120 } },
        "transportNote": { "$ref": "#/$defs/nullableText", "maxLength": 1000 },
        "blockTip": { "$ref": "#/$defs/nullableText", "maxLength": 1000 }
      }
    },
    "accommodation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "area", "note"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableText", "maxLength": 200 },
        "area": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "spot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "groupLabel", "name", "area", "category", "description", "suggestedDuration", "bestTimeToVisit", "gettingThere", "tips", "nearbyPairing", "assetId", "photoAttribution"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "groupLabel": { "$ref": "#/$defs/nullableText", "maxLength": 160 },
        "name": { "type": "string", "maxLength": 200 },
        "area": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 6000 },
        "suggestedDuration": { "type": "string", "maxLength": 120 },
        "bestTimeToVisit": { "type": "string", "maxLength": 240 },
        "gettingThere": { "type": "string", "maxLength": 1000 },
        "tips": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 1000 } },
        "nearbyPairing": { "$ref": "#/$defs/nullableText", "maxLength": 500 },
        "assetId": { "$ref": "#/$defs/nullableText", "maxLength": 80 },
        "photoAttribution": { "$ref": "#/$defs/photoAttribution" }
      }
    },
    "practical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "notIncluded", "whatToBring", "localTips", "healthSafety", "emergencyContacts"],
      "properties": {
        "included": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
        "notIncluded": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
        "whatToBring": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
        "localTips": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["topic", "note"], "properties": { "topic": { "type": "string", "maxLength": 120 }, "note": { "type": "string", "maxLength": 1000 } } } },
        "healthSafety": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
        "emergencyContacts": { "type": "array", "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["label", "value"], "properties": { "label": { "type": "string", "maxLength": 120 }, "value": { "type": "string", "maxLength": 240 } } } }
      }
    },
    "closing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closingNote", "agencyContact", "disclaimer", "photoCredits"],
      "properties": {
        "closingNote": { "type": "string", "maxLength": 2000 },
        "agencyContact": { "type": "string", "maxLength": 320 },
        "disclaimer": { "type": "string", "maxLength": 1200 },
        "photoCredits": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/photoAttribution" } }
      }
    }
  }
}
