{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itinerary-engine.local/schemas/web-itinerary-2.0.0.json",
  "title": "Standalone Itinerary Content",
  "description": "Canonical guide-centric itinerary content (web-2.0.0). Publish-only requirements and mode applicability are defined by the field registry and validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trip",
    "guide",
    "meeting",
    "pickup",
    "cover",
    "summary",
    "days",
    "places",
    "included",
    "notIncluded",
    "whatToBring",
    "localTips",
    "healthSafety",
    "emergencyContacts",
    "policies",
    "closingNote",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": {
      "const": "web-2.0.0"
    },
    "trip": {
      "$ref": "#/$defs/trip"
    },
    "guide": {
      "$ref": "#/$defs/guide"
    },
    "meeting": {
      "$ref": "#/$defs/meeting"
    },
    "pickup": {
      "$ref": "#/$defs/pickup"
    },
    "cover": {
      "anyOf": [
        {
          "$ref": "#/$defs/photo"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "days": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "included": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "notIncluded": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "whatToBring": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "localTips": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1200
      }
    },
    "healthSafety": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "emergencyContacts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/emergencyContact"
      }
    },
    "policies": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "closingNote": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "disclaimer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "$defs": {
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "title",
        "destination",
        "country",
        "region",
        "language",
        "colorTheme",
        "startDate",
        "startTime",
        "endTime"
      ],
      "properties": {
        "mode": {
          "enum": [
            "half_day",
            "full_day",
            "multi_day",
            "destination_guide"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "destination": {
          "type": "string",
          "maxLength": 200
        },
        "country": {
          "type": "string",
          "maxLength": 120
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 35
        },
        "colorTheme": {
          "enum": [
            "beach",
            "mountain",
            "city",
            "cultural",
            "nature",
            "desert",
            "mixed"
          ]
        },
        "startDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "startTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "endTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "phone"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "mapsUrl",
        "time",
        "note"
      ],
      "properties": {
        "place": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "mapsUrl": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "pickup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offered",
        "area",
        "time",
        "dropoffNote"
      ],
      "properties": {
        "offered": {
          "type": "boolean"
        },
        "area": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "dropoffNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "photoCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "photographer",
        "url",
        "source"
      ],
      "properties": {
        "photographer": {
          "type": "string",
          "maxLength": 240
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://"
        },
        "source": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "credit"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "credit": {
          "anyOf": [
            {
              "$ref": "#/$defs/photoCredit"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "hotel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "area",
        "note"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "area": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "meals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breakfast",
        "lunch",
        "dinner"
      ],
      "properties": {
        "breakfast": {
          "type": "boolean"
        },
        "lunch": {
          "type": "boolean"
        },
        "dinner": {
          "type": "boolean"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "time",
        "durationMinutes",
        "kind",
        "title",
        "place",
        "description",
        "tip"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "durationMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1440
        },
        "kind": {
          "enum": [
            "sightseeing",
            "food",
            "activity",
            "transport",
            "free"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "place": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "tip": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dayNumber",
        "title",
        "location",
        "photo",
        "activities",
        "hotel",
        "meals",
        "transferNote"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "dayNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "photo": {
          "anyOf": [
            {
              "$ref": "#/$defs/photo"
            },
            {
              "type": "null"
            }
          ]
        },
        "activities": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "hotel": {
          "anyOf": [
            {
              "$ref": "#/$defs/hotel"
            },
            {
              "type": "null"
            }
          ]
        },
        "meals": {
          "anyOf": [
            {
              "$ref": "#/$defs/meals"
            },
            {
              "type": "null"
            }
          ]
        },
        "transferNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2100
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "name",
        "area",
        "description",
        "tips",
        "gettingThere",
        "suggestedDuration",
        "bestTime",
        "nearby",
        "photo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "area": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 6000
        },
        "tips": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "gettingThere": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "suggestedDuration": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "bestTime": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "nearby": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "photo": {
          "anyOf": [
            {
              "$ref": "#/$defs/photo"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "emergencyContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "value": {
          "type": "string",
          "maxLength": 240
        }
      }
    }
  }
}
