{
  "name": "itenary-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone web itinerary brochure engine.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node scripts/validate-package.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:web-types": "node scripts/web/generate-types.mjs --check",
    "typecheck:web-contracts": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:web-contracts-v2": "tsc --noEmit -p tsconfig.contracts.json",
    "typecheck:web-app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:web-server": "node scripts/web/typecheck-scope.mjs tsconfig.app.json src/server src/contracts src/api",
    "test:web-contracts": "tsx --test tests/web/contracts.test.ts",
    "test:web-api": "tsx --test tests/web/api.test.ts",
    "test:web-store": "tsx --test tests/web/store-migration.test.ts",
    "test:web-preview": "tsx --test tests/web/preview.test.ts",
    "test:web-publication": "tsx --test tests/web/publication.test.ts",
    "test:web-editor": "tsx --test tests/web/editor.test.ts",
    "test:web-ai": "tsx --test tests/web/ai*.test.ts",
    "verify:web-editor": "tsx scripts/web/verify-editor.ts",
    "verify:web-preview": "tsx scripts/web/verify-preview.ts",
    "verify:web-publication": "tsx scripts/web/verify-publication.ts",
    "verify:web-e2e": "tsx scripts/web/verify-e2e.ts",
    "probe:web-publish-retry": "tsx scripts/web/probe-publish-retry.ts",
    "verify:web-publish-retry": "tsx scripts/web/probe-publish-retry.ts",
    "probe:web-recovery-scope": "tsx scripts/web/probe-recovery-scope.ts",
    "verify:web-ai": "tsx scripts/web/verify-ai.ts",
    "verify:web-ai-ui": "tsx scripts/web/verify-ai-ui.ts",
    "build:brochure-css": "node scripts/web/build-styles.mjs",
    "build:web-app": "vite build",
    "build:web-release": "npm run build:brochure-css && npm run build:web-app && tsc -p tsconfig.runtime.json && node scripts/web/build-release.mjs",
    "validate:web-release": "node scripts/web/validate-release.mjs",
    "verify:web-readiness": "tsx scripts/web/verify-readiness.ts",
    "verify:web-systemd": "tsx scripts/web/verify-systemd.ts",
    "dev:web-app": "vite --host 127.0.0.1",
    "start:web-app": "tsx src/server/main.ts",
    "test:web-render": "tsx --test tests/web/render.test.ts",
    "verify:web-render": "tsx scripts/web/render-fixture.ts",
    "render:pdf": "node scripts/render-pdf.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "^5.12.5",
    "franc": "6.2.0",
    "puppeteer": "25.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "json-schema-to-typescript": "15.0.4",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "typescript": "^5.8.3",
    "vite": "7.3.7"
  }
}
