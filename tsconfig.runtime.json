{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "output/releases/.build-runtime",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/server/**/*.ts", "src/render/**/*.ts", "src/contracts/**/*.ts"]
}
