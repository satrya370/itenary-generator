# Standalone web engine defaults; copy into a private local config, never commit real values.
HOST=127.0.0.1
PORT=3000
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Trusted generated share-link origin; set to the public HTTPS origin at deployment.
SHARE_ORIGIN=http://127.0.0.1:3000
ENGINE_DATA_DIR=.runtime

# Provider requests are server-side only. Inject this via process environment in deployment.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_CREDENTIAL_FILE=
OPENROUTER_DAILY_LIMIT=30
OPENROUTER_RATE_PER_MINUTE=2
OPENROUTER_MAX_IN_FLIGHT=1
OPENROUTER_CONTEXT_BYTES=16384
OPENROUTER_TIMEOUT_MS=45000
# Only for the explicit, opt-in CP023 test run. The $2 live budget is fixed server-side.
OPENROUTER_LIVE_TEST=0
# Place search for the activity place and meeting point. photon (default: OpenStreetMap data, no key, no card), google (needs the key below) or off.
PLACES_PROVIDER=photon
# Requests per UTC day; default 1000 for photon, 300 for google (keeps Google's free allowance safe).
PLACES_DAILY_LIMIT=
GOOGLE_PLACES_API_KEY=
