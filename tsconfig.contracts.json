{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/contracts/**/*.ts", "src/server/draft.ts", "tests/web/contracts.test.ts", "tests/web/fixtures.ts", "tests/web/fixtures-v2.ts"]
}
