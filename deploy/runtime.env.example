# Copy to a private EnvironmentFile; replace placeholder origins and absolute paths.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
SHARE_ORIGIN=https://itinerary.example.invalid
ENGINE_DATA_DIR=/var/lib/itinerary-engine
ENGINE_RENDER_CSS=/opt/itinerary-engine/releases/RELEASE_ID/runtime/brochure.css

# Optional provider secret: inject through a protected file/secret store, never source control.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_DAILY_LIMIT=30
OPENROUTER_RATE_PER_MINUTE=2
OPENROUTER_MAX_IN_FLIGHT=1
OPENROUTER_CONTEXT_BYTES=16384
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_LIVE_TEST=0
